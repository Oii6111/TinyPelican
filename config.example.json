{
  "selfNicknames": [
    "你的微信昵称"
  ],
  "pollMs": 700,
  "debounceMs": 5000,
  "minMatchLines": 2,
  "inboxMaxLines": 500,
  "relationCheck": {
    "enabled": true,
    "days": 7
  },
  "intent": {
    "agent": "intent",
    "highConfidence": 0.85,
    "mediumConfidence": 0.5,
    "maxMessagesPerBatch": 50,
    "agentTimeoutMs": 120000,
    "minIntervalMinutes": 0
  },
  "reminder": {
    "deadlineLeadDays": [1],
    "deadlineLeadHours": [2],
    "scheduleLeadMinutes": 30
  },
  "doNotDisturb": {
    "enabled": true,
    "start": "23:00",
    "end": "08:00"
  },
  "weixinPush": {
    "enabled": false,
    "notifyComplete": true,
    "accountId": "your-account-id",
    "to": "your-wechat-openid"
  },
  "engine": {
    "provider": "siliconflow",
    "providers": {
      "siliconflow": {
        "baseUrl": "https://api.siliconflow.cn/v1",
        "apiKey": "",
        "model": "Qwen/Qwen3.5-9B"
      },
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": "",
        "model": "gpt-4o-mini"
      },
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": "",
        "model": "deepseek-chat"
      },
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434/v1",
        "apiKey": "",
        "model": "qwen3:8b"
      },
      "custom": {
        "baseUrl": "",
        "apiKey": "",
        "model": ""
      }
    },
    "timeoutMs": 120000,
    "retries": 2
  },
  "proactivity": {
    "level": "L2"
  },
  "capture": {
    "enabled": false,
    "replySuggestions": {
      "enabled": true,
      "optionCount": 3,
      "maxHistoryMessages": 24,
      "expireSeconds": 120,
      "maxOptionChars": 120,
      "timeoutMs": 30000
    }
  },
  "heartbeat": {
    "intervalSec": 30
  }
}
