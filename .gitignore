# 依赖与构建产物
node_modules/
.dsh-tmp-*/
dist/
release/
*.tgz

# DSH 本地运行目录（会话/凭据/生成 profile 不入库）
agent/dsh-home/

# Agent 工作区只保留目录占位，实际产物不入库
agent-workspace/*
!agent-workspace/.gitkeep

# 本地数据（聊天内容/隐私，不入库）
contacts/*.json
contacts/_legacy/
inbox.jsonl
pending.jsonl
batches/*.jsonl
voice-pending.json
intents.json
intent-state.json
intent-last-run.json
remark-pending.json
relation-pushed.json
agent-tasks.jsonl
.watcher-state.json
.watcher.pid
activity.log

# 日志
logs/
*.log

# 个人配置（含微信推送账号，不入库）
config.json
config.toml
weixin-cursor.json
weixin-context.json
conversations.json
unread.json

# 密钥/凭据类文件（额外保险）
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.*

# 系统/编辑器
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
