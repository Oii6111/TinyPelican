{
  "name": "xiaotihu",
  "version": "0.1.0",
  "description": "小鹈鹕 V3 用户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.xiaotihu.app",
    "productName": "小鹈鹕",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "extraResources": [
      { "from": "../dashboard", "to": "content/dashboard" },
      { "from": "../watch-clipboard.ps1", "to": "content/watch-clipboard.ps1" },
      { "from": "../_process_batches.js", "to": "content/_process_batches.js" },
      { "from": "../config.json", "to": "content/config.json" },
      { "from": "../logo2.png", "to": "content/logo2.png" }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "../dashboard/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
