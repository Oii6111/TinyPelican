{
  "name": "xiaotihu",
  "version": "0.4.0",
  "description": "小鹈鹕 V3 用户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.xiaotihu.app",
    "productName": "小鹈鹕",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [
      { "from": "../dashboard", "to": "content/dashboard" },
      { "from": "../core", "to": "content/core" },
      { "from": "../_process_batches.js", "to": "content/_process_batches.js" },
      { "from": "../extract_intents.js", "to": "content/extract_intents.js" },
      { "from": "../remind.js", "to": "content/remind.js" },
      { "from": "../check_relations.js", "to": "content/check_relations.js" },
      { "from": "../config.json", "to": "content/config.json" },
      { "from": "../config.example.json", "to": "content/config.example.json" },
      { "from": "../RULES.md", "to": "content/RULES.md" },
      { "from": "../logo2.png", "to": "content/logo2.png" }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "../dashboard/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
